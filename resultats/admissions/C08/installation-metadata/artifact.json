  "url": "https://registry.npmjs.org/obsidian-mcp/-/obsidian-mcp-2.0.1.tgz",
  "lifecycle_scripts": {
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run eval:validate && npm run package:check",
    "lint": "eslint src",
    "test": "node --import tsx --test test/*.test.ts test/**/*.test.ts",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/make-executable.mjs",
    "clean": "node scripts/clean.mjs",
    "start": "node dist/main.js serve",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check .",
    "eval:validate": "node scripts/validate-evaluations.mjs",
    "package:check": "node scripts/check-package.mjs",
    "test:coverage": "node --import tsx --test --experimental-test-coverage test/*.test.ts test/**/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/**/*.test.ts"
  },
  "scripts_executed": false
}
